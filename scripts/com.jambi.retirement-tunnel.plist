<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jambi.retirement-tunnel — this project's own cloudflared process.

  A SEPARATE tunnel from the trading desk's, on purpose. Sharing one means
  sharing its ingress file (which is tracked in the trading-helper repo, so an
  edit breaks that repo's `git pull --ff-only`) and sharing its restarts. Two
  processes cost a few MB and remove the coupling entirely.

  Do NOT point this at the trading tunnel's id. Two processes running the same
  tunnel both connect, each with its own ingress list, and Cloudflare picks
  between them per request -- so the site would work roughly half the time,
  which is worse than not working at all.

  KeepAlive, and the config is read from this repo. cloudflared re-reads its
  config on SIGHUP; a full restart here never touches the trading tunnel.

  SHELL. /bin/zsh -lc, not bash. This is a zsh account: a login bash reads
  ~/.bash_profile and never touches ~/.zshrc or ~/.zprofile, so `bash -lc` here
  produced a bare PATH and every AI backend reported itself missing on a machine
  where all of them work from a Terminal. trading-helper hit the same wall and
  worked around it by hardcoding absolute paths (see tools/watchdog.py's
  CLOUDFLARED_PATHS); this uses the right shell AND pins absolute paths in .env,
  because either alone is one machine change away from breaking again.

  Install: scripts/install_agents.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jambi.retirement-tunnel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/jambimac/repo/retirement &amp;&amp; exec "$(command -v cloudflared || echo /opt/homebrew/bin/cloudflared)" --config config/cloudflared-config.yml --no-autoupdate tunnel run</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/jambimac/repo/retirement/logs/tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jambimac/repo/retirement/logs/tunnel.log</string>
</dict>
</plist>
