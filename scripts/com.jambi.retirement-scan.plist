<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jambi.retirement-scan — the nightly property scan and email digest.

  07:15 local, once a day. RunAtLoad is false on purpose: installing the agent
  should not fire an API-spending run, and a deploy kickstarts the WEB job, not
  this one.

  On the schedule and the API budget: one idealista call returns at most 50
  listings, and the three configured areas cost 3-6 calls per run. Daily is
  ~120-180 calls a month, which is over a 100/month free allowance. Either
  keep this daily and confirm your approved quota is higher, or switch to
  Monday/Thursday by replacing StartCalendarInterval's dict with an array of
  two dicts carrying Weekday 1 and 4. The client-side guard in
  RETIREMENT_IDEALISTA_MONTHLY_QUOTA stops the run either way rather than
  letting the month end in 429s.

  StartCalendarInterval fires on wake if the machine was asleep at the
  scheduled time, so a sleeping mini catches up rather than skipping the day.

  Install: scripts/install_agents.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jambi.retirement-scan</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/jambimac/repo/retirement &amp;&amp; ./retire scan</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>15</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>AbandonProcessGroup</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/jambimac/repo/retirement/logs/scan.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jambimac/repo/retirement/logs/scan.log</string>
</dict>
</plist>
