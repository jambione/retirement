# --- Idealista Search API ---------------------------------------------------
# Request access at https://developers.idealista.com/access-request
# You receive an API key and secret. The free tier is small; RETIREMENT_IDEALISTA_MONTHLY_QUOTA
# below is a client-side guard so a runaway loop cannot burn the month's budget.
IDEALISTA_API_KEY=
IDEALISTA_SECRET=
RETIREMENT_IDEALISTA_MONTHLY_QUOTA=100

# --- Anthropic (optional: natural-language criteria + listing assessment) ----
ANTHROPIC_API_KEY=
RETIREMENT_LLM_MODEL=claude-sonnet-4-5

# --- Email digest -----------------------------------------------------------
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=
DIGEST_TO=

# --- Paths ------------------------------------------------------------------
RETIREMENT_DB=var/retirement.sqlite3

# --- Ask B (the "B" button next to each section) ----------------------------
# Whichever of these CLIs is installed gets offered in the panel. They use the
# subscription logins already on this machine; nothing extra is billed.
#   claude_cli | grok | agy | anthropic_api
ASK_DEFAULT_PROVIDER=
ASK_CLAUDE_BIN=claude
ASK_CLAUDE_MODEL=sonnet
ASK_GROK_BIN=grok
ASK_GROK_MODEL=grok-4-fast
ASK_AGY_BIN=agy
ASK_AGY_MODEL=gemini-3.7-flash-high
