# --- Idealista Search API ---------------------------------------------------
# Request access at https://developers.idealista.com/access-request
# You receive an API key and secret. The free tier is small; RETIREMENT_IDEALISTA_MONTHLY_QUOTA
# below is a client-side guard so a runaway loop cannot burn the month's budget.
IDEALISTA_API_KEY=
IDEALISTA_SECRET=
RETIREMENT_IDEALISTA_MONTHLY_QUOTA=100

# --- AI ---------------------------------------------------------------------
# Nothing to set. Scoring, the board summary and the B button all use whichever
# subscription CLI is installed (claude / grok / agy), found automatically.
# ANTHROPIC_API_KEY is a LAST-RESORT fallback for a machine with no CLI on it;
# leaving it blank is the intended state. RETIREMENT_LLM_MODEL applies only to
# that fallback — the CLIs are configured by ASK_*_MODEL below.
ANTHROPIC_API_KEY=
RETIREMENT_LLM_MODEL=claude-sonnet-4-5

# --- Email ------------------------------------------------------------------
# Key names match trading-helper's, so the same block works in both projects
# and config/secrets.json can be pasted across. secrets.json wins over these.
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
DIGEST_TO=
DIGEST_BCC=

# --- IMAP (optional: automatic pickup of emailed eMoney exports) -------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# Point at trading-helper's secrets.json instead of keeping a second file.
# One place to rotate a password -- and this app can then read every secret
# the trading desk holds, which is why it is not the default.
# RETIREMENT_SECRETS=/Users/jambimac/repo/trading-helper/config/secrets.json

# --- Paths ------------------------------------------------------------------
RETIREMENT_DB=var/retirement.sqlite3

# --- Ask B (the "B" button next to each section) ----------------------------
# Whichever of these CLIs is installed gets offered in the panel. They use the
# subscription logins already on this machine; nothing extra is billed.
#   agy | claude_cli | grok | anthropic_api
# This project runs on the Antigravity subscription. Pinning it here rather
# than relying on preference order means a missing agy is REPORTED instead of
# quietly spending the trading desk's Claude login instead.
ASK_DEFAULT_PROVIDER=agy
# Model ids differ per install and per subscription, so none are set here: each
# CLI uses its own default unless you name one. Ask the CLI what it has --
# `agy models`, `grok models` -- and set the matching line only if you want
# something other than its default. A guessed id fails the whole call with
# "unknown model id", which is how this bit us.
ASK_AGY_BIN=agy
# ASK_AGY_MODEL=
# ASK_AGY_EFFORT=high    # only if your agy build accepts --effort
ASK_CLAUDE_BIN=claude
# ASK_CLAUDE_MODEL=
ASK_GROK_BIN=grok
# ASK_GROK_MODEL=
