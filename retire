#!/usr/bin/env bash
# ./retire — control script for the local service, same shape as ./trading.
#
#   ./retire setup                 create .venv and install
#   ./retire start|stop|restart|status
#   ./retire scan [--dry-run]      one property cycle, now
#   ./retire cycle [--dry-run]     every enabled module
#   ./retire value <cmd>           the value finder: omi | ispra | score | coverage
#   ./retire doctor                what is configured (no secrets printed)
#   ./retire email-test            send one real message to prove it works
#   ./retire ai-test               send one prompt to the AI backend, show the error
#   ./retire tunnel                tunnel id, process state, recent log
#   ./retire omi [file]            import official OMI market values / show status
#   ./retire list                  current shortlist in the terminal
set -uo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# An ssh session gets a bare PATH: Homebrew is not on it, which is where a
# modern python and cloudflared actually live on this machine.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH
PORT="${RETIREMENT_PORT:-8891}"
PIDFILE="$ROOT/var/retirement.pid"
LOG="$ROOT/logs/retirement.log"
VENV="$ROOT/.venv"
PY="$VENV/bin/python"

mkdir -p "$ROOT/var" "$ROOT/logs"

need_venv() { [ -x "$PY" ] || { echo "No virtualenv yet. Run: ./retire setup"; exit 1; }; }

# macOS ships python3.9; this needs 3.11+. Find a real one rather than failing
# three steps later with a dependency-resolution error that does not mention
# the version at all.
find_python() {
  if [ -n "${RETIREMENT_PYTHON:-}" ]; then echo "$RETIREMENT_PYTHON"; return 0; fi
  for candidate in python3.14 python3.13 python3.12 python3.11 python3 \
                   /opt/homebrew/bin/python3.14 /opt/homebrew/bin/python3.13 \
                   /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.11 \
                   /usr/local/bin/python3.12 /usr/local/bin/python3.11; do
    bin="$(command -v "$candidate" 2>/dev/null)" || bin=""
    [ -z "$bin" ] && [ -x "$candidate" ] && bin="$candidate"
    [ -z "$bin" ] && continue
    if "$bin" -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)' 2>/dev/null; then
      echo "$bin"; return 0
    fi
  done
  return 1
}
is_running() { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-status}" in
  setup)
    # uv can fetch an interpreter itself, which is the shortest path on a
    # machine whose system python is too old -- no brew, no sudo, no PATH
    # surgery. Only fall back to hunting for one when uv is absent.
    if command -v uv >/dev/null 2>&1; then
      echo "· uv found — using it (it fetches Python 3.12 if this machine has none)"
      uv venv --python 3.12 "$VENV" || exit 1
      uv pip install --python "$PY" -e ".[dev]" || exit 1
      "$PY" -c "import retirement, fastapi, httpx" 2>/dev/null || {
        echo "❌ the package does not import after install — setup did NOT succeed"; exit 1; }
      [ -f .env ] || { cp .env.example .env; echo "→ created .env, fill in your keys"; }
      echo "✓ setup complete ($("$PY" -V 2>&1))"
      exit 0
    fi

    PY_BIN="$(find_python)" || {
      echo "❌ No Python 3.11 or newer on this machine."
      echo "   Found: $(python3 -V 2>&1). macOS ships 3.9; this needs 3.11+."
      echo "   Fix with either:"
      echo "     brew install python@3.12"
      echo "     curl -LsSf https://astral.sh/uv/install.sh | sh   # then rerun"
      echo "   Or point at one you already have:  RETIREMENT_PYTHON=/path/to/python3.12 ./retire setup"
      exit 1
    }
    echo "· using $PY_BIN ($("$PY_BIN" -V 2>&1))"

    "$PY_BIN" -m venv "$VENV" || exit 1
    "$PY" -m pip install -qU pip || exit 1
    # Not quiet: a failure here is the whole point of running setup, and it
    # used to scroll past under a "✓ setup complete" that was not true.
    "$PY" -m pip install -e ".[dev]" || {
      echo "❌ dependency install failed — see the error above"; exit 1
    }

    "$PY" -c "import retirement, fastapi, httpx" 2>/dev/null || {
      echo "❌ the package does not import after install — setup did NOT succeed"
      exit 1
    }
    [ -f .env ] || { cp .env.example .env; echo "→ created .env, fill in your keys"; }
    echo "✓ setup complete"
    ;;

  start)
    need_venv
    if is_running; then echo "already running (pid $(cat "$PIDFILE"))"; exit 0; fi
    nohup "$VENV/bin/uvicorn" retirement.web.app:app \
      --host 127.0.0.1 --port "$PORT" >> "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    echo "✓ started on http://127.0.0.1:$PORT (pid $(cat "$PIDFILE"))"
    ;;

  stop)
    # KeepAlive means launchd restarts it within seconds. Say so rather than
    # letting "stopped" be quietly untrue.
    if pgrep -f "[.]venv/bin/uvicorn retirement[.]web" >/dev/null 2>&1 && ! is_running; then
      echo "! this is the LaunchAgent's process; launchd will restart it."
      echo "  To stop it properly:  launchctl bootout gui/\$(id -u)/com.jambi.retirement-web"
    fi
    if is_running; then
      kill "$(cat "$PIDFILE")" && rm -f "$PIDFILE" && echo "✓ stopped"
    else
      pkill -f "[.]venv/bin/uvicorn retirement[.]web" 2>/dev/null && echo "✓ stopped (by pattern)" || echo "not running"
      rm -f "$PIDFILE"
    fi
    ;;

  restart) "$0" stop; sleep 1; "$0" start ;;

  status)
    # Under launchd there is no pidfile -- the LaunchAgent execs uvicorn itself,
    # which is why this used to report "not running" for a perfectly healthy
    # service. Ask the process table too.
    LAUNCHD_PID="$(pgrep -f "[.]venv/bin/uvicorn retirement[.]web" | head -1)"
    if is_running; then
      echo "✓ web  running (pid $(cat "$PIDFILE"), started by ./retire) on :$PORT"
    elif [ -n "$LAUNCHD_PID" ]; then
      echo "✓ web  running (pid $LAUNCHD_PID, LaunchAgent) on :$PORT"
    else
      echo "✗ web  not running"
      [ -f "$LOG" ] && echo "  last log line: $(tail -1 "$LOG")"
    fi
    curl -s --max-time 3 "http://127.0.0.1:$PORT/healthz" >/dev/null \
      && echo "✓ http healthz ok" || echo "✗ http not answering"
    if [ -x "$PY" ]; then
      "$PY" - <<'PYEOF' 2>/dev/null || true
from retirement.core.config import load_dotenv, db_path
from retirement.core import db
load_dotenv()
if db_path().exists():
    conn = db.connect()
    row = conn.execute("SELECT COUNT(*) c FROM sqlite_master WHERE name='listings'").fetchone()
    if row and row["c"]:
        n = conn.execute("SELECT COUNT(*) c FROM listings WHERE active=1").fetchone()["c"]
        print(f"  {n} active listings · {db.usage_this_month(conn,'idealista')} idealista calls this month")
PYEOF
    fi
    ;;

  scan) need_venv; shift || true; "$PY" -m retirement.cli run property "$@" ;;
  cycle) need_venv; shift || true; "$PY" -m retirement.cli run all "$@" ;;
  doctor) need_venv; "$PY" -m retirement.cli doctor ;;
  email-test) need_venv; shift || true; "$PY" -m retirement.cli email-test "$@" ;;
  omi) need_venv; shift || true; "$PY" -m retirement.cli omi "$@" ;;
  probe) need_venv; shift || true; "$PY" -m retirement.cli probe "$@" ;;
  ai-test) need_venv; shift || true; "$PY" -m retirement.cli ai-test "$@" ;;
  tunnel) need_venv; "$PY" -m retirement.cli tunnel ;;
  value) need_venv; shift || true; "$PY" -m retirement.cli value "$@" ;;
  list) need_venv; "$PY" -m retirement.cli list ;;
  *)    sed -n '2,8p' "$0"; exit 2 ;;
esac
